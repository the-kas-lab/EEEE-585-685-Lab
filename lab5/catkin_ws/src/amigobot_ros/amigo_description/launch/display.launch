<?xml version="1.0"?>
<!-- Model-only viewer.  No Gazebo, no robot: use this to sanity check the URDF.
       roslaunch amigo_description display.launch                              -->
<launch>
  <arg name="gui" default="true"/>

  <param name="robot_description"
         command="$(find xacro)/xacro '$(find amigo_description)/urdf/amigo.urdf.xacro' simulation:=false"/>

  <node name="joint_state_publisher_gui" pkg="joint_state_publisher_gui"
        type="joint_state_publisher_gui" if="$(arg gui)"/>
  <node name="joint_state_publisher" pkg="joint_state_publisher"
        type="joint_state_publisher" unless="$(arg gui)"/>

  <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher"/>

  <node name="rviz" pkg="rviz" type="rviz" required="true"
        args="-d $(find amigo_description)/rviz/amigo.rviz"/>
</launch>
