<?xml version="1.0"?>
<!--
  amigo_sim.launch  - the simulated AmigoBot.

      roslaunch amigo_gazebo amigo_sim.launch

  Useful arguments:
      gui:=false        headless Gazebo (much faster on a VM)
      rviz:=false       skip RViz
      steering:=true    also open rqt_robot_steering for teleoperation
      x:= y:= yaw:=     spawn pose
-->
<launch>
  <arg name="world"    default="$(find amigo_gazebo)/worlds/amigo_lab.world"/>
  <arg name="gui"      default="true"/>
  <arg name="paused"   default="false"/>
  <arg name="rviz"     default="true"/>
  <arg name="steering" default="false"/>

  <arg name="x"   default="0.0"/>
  <arg name="y"   default="0.0"/>
  <arg name="z"   default="0.06"/>   <!-- base_link is on the axle, r = 0.0508 -->
  <arg name="yaw" default="0.0"/>

  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name"   value="$(arg world)"/>
    <arg name="paused"       value="$(arg paused)"/>
    <arg name="gui"          value="$(arg gui)"/>
    <arg name="use_sim_time" value="true"/>
    <arg name="debug"        value="false"/>
  </include>

  <!-- robot_description + robot_state_publisher -->
  <include file="$(find amigo_description)/launch/description.launch">
    <arg name="simulation" value="true"/>
    <arg name="publish_fake_joint_states" value="false"/>
  </include>

  <node name="spawn_amigo" pkg="gazebo_ros" type="spawn_model"
        args="-urdf -param robot_description -model amigo
              -x $(arg x) -y $(arg y) -z $(arg z) -Y $(arg yaw)"
        output="screen"/>

  <!-- /wheel_velocities and the sonar bridge -->
  <include file="$(find amigo_tools)/launch/amigo_interface.launch">
    <arg name="simulation" value="true"/>
  </include>

  <node if="$(arg rviz)" name="rviz" pkg="rviz" type="rviz"
        args="-d $(find amigo_description)/rviz/amigo.rviz"/>

  <node if="$(arg steering)" name="rqt_robot_steering" pkg="rqt_robot_steering"
        type="rqt_robot_steering"/>
</launch>
