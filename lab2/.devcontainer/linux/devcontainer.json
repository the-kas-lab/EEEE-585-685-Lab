{
  "name": "lynxmotion arm (ROS 1 Noetic - Linux)",
  "build": {
    "dockerfile": "../../docker/Dockerfile",
    "context": "../../docker",
    "args": {
      "USERNAME": "robotuser",
      "USER_UID": "1000",
      "USER_GID": "1000"
    }
  },
  "remoteUser": "robotuser",
  "updateRemoteUserUID": true,
  "postCreateCommand": "sed -i 's/\\r$//' docker/postCreate.sh && bash docker/postCreate.sh",
  "runArgs": [
    "--network=host",
    "-e",
    "DISPLAY=${localEnv:DISPLAY}",
    "-v",
    "/tmp/.X11-unix:/tmp/.X11-unix:rw",
    // Serial passthrough for the SSC-32U. Bind-mounting /dev instead of
    // "--device=/dev/ttyUSB0" means the container starts whether or not the
    // arm is attached, and a device plugged in later shows up without a
    // rebuild. The cgroup rules grant access to the tty majors the adapter
    // may enumerate as: 188 = ttyUSB* (FTDI/CP210x), 166 = ttyACM* (CDC-ACM).
    "-v",
    "/dev:/dev",
    "--device-cgroup-rule=c 188:* rmw",
    "--device-cgroup-rule=c 166:* rmw",
    // "dialout" resolves inside the container (Ubuntu: GID 20). Fedora and
    // RHEL-family hosts own serial nodes by GID 18, so add that numerically.
    "--group-add=dialout",
    "--group-add=18"
  ],
  "containerEnv": {
    "DISPLAY": "${localEnv:DISPLAY}",
    "LIBGL_ALWAYS_INDIRECT": "0",
    "QT_X11_NO_MITSHM": "1"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-iot.vscode-ros"
      ]
    }
  }
}
