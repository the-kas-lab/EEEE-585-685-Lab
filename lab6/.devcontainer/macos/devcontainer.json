{
  "name": "Husky A200 (ROS 2 Humble - macOS)",
  "build": {
    "dockerfile": "../../docker/Dockerfile",
    "context": "../../docker",
    "args": {
      "USERNAME": "robotuser",
      "USER_UID": "1000",
      "USER_GID": "1000"
    }
  },
  "remoteUser": "robotuser",
  "updateRemoteUserUID": true,
  "postCreateCommand": "sed -i 's/\\r$//' docker/postCreate.sh && bash docker/postCreate.sh",
  "runArgs": [
    "--shm-size=1g",
    "-e",
    "DISPLAY=host.docker.internal:0"
  ],
  "containerEnv": {
    "DISPLAY": "host.docker.internal:0",
    "LIBGL_ALWAYS_INDIRECT": "0",
    "LIBGL_ALWAYS_SOFTWARE": "1",
    "QT_X11_NO_MITSHM": "1",
    "ROS_DOMAIN_ID": "0",
    "ROS_LOCALHOST_ONLY": "0"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-iot.vscode-ros"
      ],
      "settings": {
        "files.eol": "\n"
      }
    }
  }
}
