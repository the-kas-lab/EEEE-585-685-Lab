Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid (1 m)
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 20
      Color: 160; 160; 164
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Floor tape
      Enabled: true
      Topic:
        Value: /lab6/floor
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Depth: 1
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Name: Husky
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Depth: 1
      Value: true
    - Class: rviz_default_plugins/Odometry
      Name: Odometry
      Enabled: true
      Topic:
        Value: /a200_0252/platform/odom
        Reliability Policy: Reliable
        Durability Policy: Volatile
        Depth: 10
      Keep: 200
      Position Tolerance: 0.05
      Angle Tolerance: 0.1
      Shape:
        Value: Arrow
        Color: 255; 25; 0
        Alpha: 1
        Shaft Length: 0.3
        Shaft Radius: 0.02
        Head Length: 0.08
        Head Radius: 0.05
      Covariance:
        Value: false
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: odom
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Measure
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 9
      Focal Point:
        X: 2
        Y: 0
        Z: 0
      Pitch: 0.75
      Yaw: 3.6
      Name: Current View
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
Window Geometry:
  Height: 800
  Width: 1200
